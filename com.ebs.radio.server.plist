<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
	    <key>Label</key>
	    <string>com.ebs.radio.server</string>
	    <key>ProgramArguments</key>
	    <array>
        <string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
	        <string>/Users/YOUR_USER/Library/Application Support/EBSPrivatePodcast/podcast_server.py</string>
	    </array>
	    <key>EnvironmentVariables</key>
	    <dict>
	        <key>PODCAST_PORT</key>
	        <string>8081</string>
	        <key>PODCAST_SITE_ROOT</key>
	        <string>/Users/YOUR_USER/Library/Application Support/EBSPrivatePodcast/site</string>
	    </dict>
	    <key>RunAtLoad</key>
	    <true/>
	    <key>KeepAlive</key>
	    <true/>
	    <key>StandardOutPath</key>
	    <string>/Users/YOUR_USER/Library/Logs/com.ebs.radio.server.log</string>
	    <key>StandardErrorPath</key>
	    <string>/Users/YOUR_USER/Library/Logs/com.ebs.radio.server.log</string>
	</dict>
</plist>
